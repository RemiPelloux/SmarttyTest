#!/usr/bin/env bash
# Local quality gate, the same `pnpm verify` CI runs (.github/workflows/ci.yml): lint, package
# boundaries, typecheck, tests and planning consistency must pass before pushing.
# Install once: pnpm hooks:install · Bypass in an emergency: git push --no-verify
set -euo pipefail
cd "$(git rev-parse --show-toplevel)"
if pnpm --version >/dev/null 2>&1; then
  PNPM=(pnpm)
else
  # Use the version pinned in package.json#packageManager.
  PNPM=(npx --yes "$(node -p "require('./package.json').packageManager")")
fi
echo "pre-push: ${PNPM[*]} verify"
"${PNPM[@]}" verify
