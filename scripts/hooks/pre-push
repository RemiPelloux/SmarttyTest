#!/usr/bin/env bash
# Local quality gate, the same `pnpm verify` CI runs (.github/workflows/ci.yml): lint, package
# boundaries, typecheck, tests and planning consistency must pass before pushing.
# Install once: pnpm hooks:install · Bypass in an emergency: git push --no-verify
set -euo pipefail
cd "$(git rev-parse --show-toplevel)"
# Git exports GIT_DIR (and more, in a worktree) to hooks. The tests create throwaway repositories
# with `git init`/`commit`/`init --bare`; with GIT_DIR inherited, every one of those commands would
# write into this repository instead (commits, branches, even core.bare=true). Drop them.
# shellcheck disable=SC2046
unset $(git rev-parse --local-env-vars)
if pnpm --version >/dev/null 2>&1; then
  PNPM=(pnpm)
else
  # Use the version pinned in package.json#packageManager.
  PNPM=(npx --yes "$(node -p "require('./package.json').packageManager")")
fi
echo "pre-push: ${PNPM[*]} verify"
"${PNPM[@]}" verify
