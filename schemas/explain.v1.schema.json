{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://remipelloux.github.io/SmarttyTest/schemas/explain.v1.schema.json",
  "title": "smarttest explain --json (v1)",
  "type": "object",
  "required": ["schemaVersion", "command", "kind", "target"],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "command": {
      "const": "explain"
    },
    "kind": {
      "enum": ["test", "source"]
    },
    "loadedBy": {
      "description": "Source files: runners that load the file for their tests because their configuration names it (setup file, configuration import, mapped module), with those tests.",
      "type": "array",
      "items": {
        "type": "object",
        "required": ["reason", "tests"]
      }
    },
    "units": {
      "description": "With --units: tests protecting each named unit of the source file.",
      "type": "array",
      "items": {
        "type": "object",
        "required": ["unit", "tests"]
      }
    }
  }
}
