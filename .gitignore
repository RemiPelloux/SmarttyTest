# Dependencies
node_modules/

# Build output
dist/
.publish/
*.tsbuildinfo
coverage/

# VS Code downloaded by the extension's real-host test
.vscode-test/

# SmartTest local state (never commit)
.smarttest/

# Logs & OS
*.log
npm-debug.log*
.DS_Store
Thumbs.db

# Env & secrets
.env
.env.*
!.env.example
# Fixture inputs, not secrets.
!fixtures/projects/**/.env.test
!fixtures/projects/**/.env.testing

# Editors
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json

# documentation site build and design-inspection output
site/dist/
.taste-skill/

# Python fixtures run natively
__pycache__/
.pytest_cache/

# PHP fixtures: Composer installs their dependencies (composer install in each fixture)
fixtures/projects/php-*/vendor/
fixtures/projects/php-*/bootstrap/cache/*.php
.phpunit.cache/
.phpunit.result.cache
