{
  "name": "@smarttest/adapter-python",
  "version": "1.2.0",
  "description": "pytest and unittest runner adapters (preview).",
  "license": "Apache-2.0",
  "type": "module",
  "private": true,
  "exports": {
    ".": {
      "@smarttest/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b --noEmit false"
  },
  "dependencies": {
    "@smarttest/shared": "workspace:*",
    "@smarttest/plugin-sdk": "workspace:*"
  },
  "smarttest": {
    "epic": "EXE",
    "release": "1.1.0"
  }
}
