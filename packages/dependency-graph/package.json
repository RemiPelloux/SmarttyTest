{
  "name": "@smarttest/dependency-graph",
  "version": "0.9.0",
  "description": "Hybrid dependency graph with provenance, persistence and queries.",
  "license": "Apache-2.0",
  "type": "module",
  "private": true,
  "exports": {
    ".": {
      "@smarttest/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b --noEmit false"
  },
  "dependencies": {
    "@smarttest/shared": "workspace:*",
    "@smarttest/source-parser": "workspace:*",
    "@smarttest/symbol-index": "workspace:*"
  },
  "smarttest": {
    "epic": "GRA",
    "release": "1.0.0"
  },
  "devDependencies": {
    "@smarttest/language-typescript": "workspace:*"
  }
}
