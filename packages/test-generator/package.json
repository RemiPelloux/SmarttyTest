{
  "name": "@smarttest/test-generator",
  "version": "0.4.0",
  "description": "Test architecture generation, layouts, templates and sync.",
  "license": "Apache-2.0",
  "type": "module",
  "private": true,
  "exports": {
    ".": {
      "@smarttest/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b --noEmit false"
  },
  "dependencies": {
    "@smarttest/shared": "workspace:*",
    "@smarttest/config": "workspace:*",
    "@smarttest/source-parser": "workspace:*",
    "@smarttest/symbol-index": "workspace:*",
    "@smarttest/dependency-graph": "workspace:*",
    "@smarttest/rules-engine": "workspace:*",
    "@smarttest/test-discovery": "workspace:*"
  },
  "smarttest": {
    "epic": "GEN",
    "release": "1.0.0"
  }
}
