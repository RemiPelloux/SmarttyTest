{
  "name": "smarttest",
  "version": "1.1.1",
  "description": "Test impact analysis: run only the tests a change can affect, with the reason for each. TypeScript & JavaScript (Jest, Vitest, node:test, Playwright, Cypress, Angular), plus Python and PHP previews.",
  "license": "Apache-2.0",
  "homepage": "https://remipelloux.github.io/SmarttyTest/",
  "bugs": {
    "url": "https://github.com/RemiPelloux/SmarttyTest/issues"
  },
  "funding": {
    "type": "github",
    "url": "https://github.com/sponsors/RemiPelloux"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/RemiPelloux/SmarttyTest.git",
    "directory": "packages/cli"
  },
  "keywords": [
    "testing",
    "test-impact-analysis",
    "test-selection",
    "affected-tests",
    "jest",
    "vitest",
    "node-test",
    "playwright",
    "cypress",
    "typescript",
    "javascript",
    "pre-commit",
    "ci",
    "monorepo",
    "angular",
    "pytest",
    "python",
    "phpunit",
    "pest",
    "php",
    "laravel",
    "git-hooks",
    "regression-testing",
    "dependency-graph"
  ],
  "type": "module",
  "private": false,
  "bin": {
    "smarttest": "./dist/bin.js"
  },
  "exports": {
    ".": {
      "@smarttest/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b --noEmit false"
  },
  "dependencies": {
    "@smarttest/shared": "workspace:*",
    "@smarttest/config": "workspace:*",
    "@smarttest/core": "workspace:*",
    "@smarttest/smart-init": "workspace:*",
    "@smarttest/studio": "workspace:*"
  },
  "smarttest": {
    "epic": "CLI",
    "release": "1.0.0"
  }
}
