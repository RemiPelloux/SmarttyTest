{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://smarttest.dev/schemas/shard.v1.json",
  "title": "smarttest shard --json (v1)",
  "type": "object",
  "required": ["schemaVersion", "command", "total", "index", "files"],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "command": {
      "const": "shard"
    },
    "total": {
      "type": "integer",
      "minimum": 1
    },
    "index": {
      "type": "integer",
      "minimum": 1
    },
    "files": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
