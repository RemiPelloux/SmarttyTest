{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://smarttest.dev/schemas/run.v1.json",
  "title": "smarttest run --json (v1)",
  "type": "object",
  "required": ["schemaVersion", "command", "report", "reports", "integrityIssues"],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "command": {
      "const": "run"
    },
    "report": {
      "type": "object",
      "required": [
        "schemaVersion",
        "tool",
        "runId",
        "command",
        "startedAt",
        "finishedAt",
        "project",
        "mode",
        "change",
        "decision",
        "executions",
        "summary",
        "timings",
        "warnings"
      ],
      "properties": {
        "decision": {
          "type": "object",
          "required": [
            "selectedTests",
            "skippedTests",
            "affectedFiles",
            "affectedSymbols",
            "analysisStatus",
            "safetyMode",
            "reasons",
            "warnings",
            "fallbackApplied"
          ]
        },
        "summary": {
          "type": "object",
          "required": [
            "totalTests",
            "selected",
            "executed",
            "skippedBySelection",
            "passed",
            "failed",
            "flaky",
            "timedOut",
            "cancelled",
            "infrastructureErrors",
            "skippedByTests",
            "durationMs"
          ]
        },
        "executions": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["file", "adapter", "status", "durationMs", "tests"]
          }
        },
        "leftToCi": {
          "description": "Hook runs only: selected test files the hook scope (hook.runners, hook.exclude) did not run. Never passed; summary.leftToCi counts them.",
          "type": "array",
          "items": {
            "type": "object",
            "required": ["file", "adapter", "rule"]
          }
        }
      }
    },
    "reports": {
      "type": "object"
    },
    "integrityIssues": {
      "type": "array"
    }
  }
}
