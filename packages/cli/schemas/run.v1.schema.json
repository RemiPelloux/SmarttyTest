{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://smarttest.dev/schemas/run.v1.json",
  "title": "smarttest run --json (v1)",
  "type": "object",
  "required": ["schemaVersion", "command", "report", "reports", "integrityIssues"],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "command": {
      "const": "run"
    },
    "report": {
      "type": "object",
      "required": [
        "schemaVersion",
        "tool",
        "runId",
        "command",
        "startedAt",
        "finishedAt",
        "project",
        "mode",
        "change",
        "decision",
        "executions",
        "summary",
        "timings",
        "warnings"
      ],
      "properties": {
        "decision": {
          "type": "object",
          "required": [
            "selectedTests",
            "skippedTests",
            "affectedFiles",
            "affectedSymbols",
            "analysisStatus",
            "safetyMode",
            "reasons",
            "warnings",
            "fallbackApplied"
          ]
        },
        "summary": {
          "type": "object",
          "required": [
            "totalTests",
            "selected",
            "executed",
            "skippedBySelection",
            "passed",
            "failed",
            "flaky",
            "timedOut",
            "cancelled",
            "infrastructureErrors",
            "skippedByTests",
            "durationMs"
          ]
        },
        "executions": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["file", "adapter", "status", "durationMs", "tests"]
          }
        },
        "change": {
          "type": "object",
          "required": ["description", "changeSet"],
          "properties": {
            "only": {
              "description": "Present only with --only: the change set was restricted to these paths before selection. The dependency analysis was not restricted.",
              "type": "object",
              "required": ["paths", "matched", "unchanged", "excluded"],
              "properties": {
                "paths": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  },
                  "description": "Requested project-relative files or directories."
                },
                "matched": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  },
                  "description": "Changed files kept for selection."
                },
                "unchanged": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  },
                  "description": "Requested paths with no change: no test is selected for them."
                },
                "excluded": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  },
                  "description": "Other changed files, left out: tests affected only by them were not selected."
                }
              }
            }
          }
        },
        "leftToCi": {
          "description": "Hook runs only: selected test files the hook scope (hook.runners, hook.exclude) did not run. Never passed; summary.leftToCi counts them.",
          "type": "array",
          "items": {
            "type": "object",
            "required": ["file", "adapter", "rule"]
          }
        }
      }
    },
    "reports": {
      "type": "object"
    },
    "integrityIssues": {
      "type": "array"
    }
  }
}
